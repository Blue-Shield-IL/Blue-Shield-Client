{
  "useTabs": false,
  "tabWidth": 2,
  "singleQuote": false,
  "arrowParens": "avoid",
  "trailingComma": "es5",
  "bracketSameLine": false,
  "semi": true,
  "bracketSpacing": true,
  "endOfLine": "auto",
  "plugins": ["prettier-plugin-sort-imports"],
  "sortingMethod": "lineLength",
  "sortingOrder": "ascending"
}
